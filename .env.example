# Скопируй этот файл в .env и впиши свои значения:
#   cp .env.example .env

# Обязательно: бесплатный ключ с console.groq.com (без карты)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Необязательно: Anthropic ключ, если хочешь Claude вместо Groq где-то в коде
ANTHROPIC_API_KEY=

# Необязательно: Fish Audio TTS (платный). Если не задан — используется
# бесплатный Edge TTS (голоса ниже уже выбраны по умолчанию)
FISH_API_KEY=

# Как JARVIS будет к тебе обращаться
USER_NAME=sir
HONORIFIC=sir

# Через запятую, e.g. you@gmail.com,work@company.com. Пусто = все календари
CALENDAR_ACCOUNTS=

# Настройки голоса Edge TTS
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=-5Hz
